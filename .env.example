# Backend-only Supabase configuration. Use the credentials of your test clone.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PORT=4000

# Optional: how the server caches the Supabase data (defaults shown, values in milliseconds).
# ANALYTICS_CACHE_TTL_MS=300000    # reload the whole table at most every 5 minutes
# ANALYTICS_MAX_STALE_MS=900000    # keep serving the last complete data for up to 15 minutes if Supabase is struggling
